<Project>

  <!--
    Loaded by every project under tests/. Applies only to the test
    directory; production projects are unaffected. Centralises the
    xUnit `using` so individual test csproj files do not have to repeat
    it and so the OfficeIntegration xunit trait is easy to find.

    The first thing this file does is import the root
    Directory.Build.props, so the repository-wide settings
    (warnings-as-errors, analyzers, nullable, central package
    management, lock file) apply to test projects as well.
  -->

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Test projects intentionally do not enforce code style in build.
    The xUnit convention uses snake_case method names (CA1707),
    braceless if statements (IDE0011), and other patterns that the
    production-style analyzers flag as violations. The discipline is
    that test code is reviewed for correctness, not for production
    style conformance.

    The .editorconfig [tests/**/*.cs] section provides a softer
    hint: the analyzers still report diagnostics in the IDE, but
    they do not fail the build.
  -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <!--
      Test projects do not emit XML documentation files. The root
      props set GenerateDocumentationFile=true so that public API in
      src/ is documented (CS1591 enforced); test classes and methods
      are not API and requiring XML docs on every [Fact] would hurt
      readability. CS1591 does not fire for test projects.
    -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The OfficeIntegration xUnit trait category is a string literal
      ("OfficeIntegration") applied to tests that require a real Microsoft
      365 install (per docs/adr/0001). Tests are tagged
      [Trait("Category","OfficeIntegration")] and excluded by
      scripts/verify-quick.ps1 and scripts/verify.ps1 by default.
    -->
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
