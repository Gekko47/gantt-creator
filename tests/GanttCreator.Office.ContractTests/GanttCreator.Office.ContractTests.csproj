<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!--
      NETSDK1100: allow resolving the Windows targeting pack when building
      on a non-Windows host (no-op on Windows builds).
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>GanttCreator.Office.ContractTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <!--
      Moq. Used to proxy Microsoft.Office.Interop.Excel.Application (an
      interface in the Office PIA) and its AppEvents_Event event interface, so
      the Excel application adapter's workbook fact and its exactly-once event
      subscribe/detach bookkeeping are proven without a live Excel host.
    -->
    <PackageReference Include="Moq" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GanttCreator.Core\GanttCreator.Core.csproj" />
    <ProjectReference Include="..\..\src\GanttCreator.Office\GanttCreator.Office.csproj" />
  </ItemGroup>
</Project>