<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!--
      NETSDK1100: allow resolving the Windows targeting pack when building
      on a non-Windows host (no-op on Windows builds).
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>GanttCreator.Raster.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GanttCreator.Core\GanttCreator.Core.csproj" />
    <ProjectReference Include="..\..\src\GanttCreator.Raster\GanttCreator.Raster.csproj" />
  </ItemGroup>

  <!--
    R8.2: the category-1 raster golden baseline (the fixture scene JSON, the
    exact BGRA pixel baseline, and the human-review PNG) is committed under
    tests/golden/raster/ and copied to the test output, so the comparison
    reads the committed file rather than a source-relative path (checklist G).
    R8.4 adds the shared reference scene: the representative suite loads the
    committed golden scene through SceneSnapshot.Deserialize rather than a
    second fixture copy.
  -->
  <ItemGroup>
    <None Include="..\golden\raster\**\*" Link="golden\raster\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\golden\scene\reference-scene.json" Link="golden\scene\reference-scene.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>