{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "verify-quick",
      "detail": "Runs format check, Release build, and non-Office unit tests (~10 s).",
      "type": "process",
      "command": "${workspaceFolder}/scripts/verify-quick.ps1",
      "args": [],
      "options": { "shell": { "executable": "pwsh", "args": ["-NoProfile"] } },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "close": false, "panel": "shared" }
    },
    {
      "label": "verify-full",
      "detail": "Runs format/analyzer check, Release build, all tests with coverage, and hygiene checks (~60 s).",
      "type": "process",
      "command": "${workspaceFolder}/scripts/verify.ps1",
      "args": [],
      "options": { "shell": { "executable": "pwsh", "args": ["-NoProfile"] } },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "close": false, "panel": "shared" }
    },
    {
      "label": "test",
      "detail": "Runs all non-Office tests (dotnet test, OfficeIntegration excluded).",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "--filter", "Category!=OfficeIntegration"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "test-all",
      "detail": "Runs all tests including OfficeIntegration (requires Microsoft 365 on Windows).",
      "type": "process",
      "command": "dotnet",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "build",
      "detail": "Release build with warnings as errors.",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "--configuration", "Release", "-warnaserror"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "build-clean",
      "detail": "Cleans and rebuilds the Release configuration.",
      "type": "process",
      "command": "dotnet",
      "args": ["clean", "--configuration", "Release", "&&", "dotnet", "build", "--configuration", "Release"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"]
    }
  ]
}
