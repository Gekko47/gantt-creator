<Project>

  <!--
    Central package management. Versions are pinned here; individual csproj
    files use <PackageReference Include="..." /> with no Version attribute.
    Bumping a version here is a single, reviewable change.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>

    <!--
      Excel-DNA 1.9.0. The AddIn project uses ExcelDna.AddIn. The Integration
      and Interop libraries are listed here for explicit pinning and so that
      the Office / Raster projects can take a direct reference without a
      transitive surprise on a future NuGet resolution.

      - ExcelDna.AddIn       1.9.0  (latest stable; produces the .xll)
      - ExcelDna.Integration 1.9.0  (transitive of AddIn; pinned here)
      - ExcelDna.Interop    16.0.0 (latest stable; ships the Office PIAs
                                     as net6.0-windows7.0, compatible with
                                     net10.0-windows per nuget.org metadata)

      See docs/adr/0004-exceldna-package-versions.md.
    -->
    <PackageVersion Include="ExcelDna.AddIn"       Version="1.9.0" />
    <PackageVersion Include="ExcelDna.Integration" Version="1.9.0" />
    <PackageVersion Include="ExcelDna.Interop"    Version="16.0.0" />

    <!--
      R7.1 / ADR-0069. The PowerPoint PIA is NOT supplied by ExcelDna.Interop
      16.0.0 (its restored file list is the Excel PIA, Microsoft.Vbe.Interop
      and office.dll only). Microsoft publishes no 16.x PowerPoint interop
      package; 15.0.4420.1018 is the highest published version and is the
      Microsoft-signed Office 2013 PIA repackaged for NuGet
      (assembly version 15.0.0.0). It carries only
      Microsoft.Office.Interop.PowerPoint.dll, so it adds no second office.dll.
    -->
    <PackageVersion Include="Microsoft.Office.Interop.PowerPoint" Version="15.0.4420.1018" />

    <!--
      R8.2 / ADR-0071. SkiaSharp is the raster renderer's drawing library
      (docs/02-ARCHITECTURE.md "PNG renderer"). Version 4.157.0 was probed
      against nuget.org on 2026-11-23: both packages are MIT, the managed
      package carries a lib/net10.0 asset, and the native package carries
      libSkiaSharp.dll under runtimes/win-{x64,x86,arm64}/native.
      SkiaSharp's default loader does not resolve the packed native resource,
      so the add-in ships libSkiaSharp.dll BESIDE the XLL (R8.2 D5: R10.2
      copies it, R10.7 records the MIT notice). SKPath.MoveTo/LineTo/Close
      are obsolete in this version; SKPathBuilder is the probed replacement.
    -->
    <PackageVersion Include="SkiaSharp" Version="4.157.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="4.158.0" />

    <!-- xUnit. The unit / contract / addin test projects use these. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk"           Version="18.12.0" />
    <PackageVersion Include="xunit"                            Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio"        Version="4.0.1" />
    <PackageVersion Include="coverlet.collector"               Version="10.1.1" />

    <!-- Moq. Used only by AddIn contract tests to fake IRollingLog without the filesystem. -->
    <PackageVersion Include="Moq"                              Version="4.21.0" />

    <!-- Roslyn. Used by EnvVarGuardScanner to parse C# string literals accurately. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />

  </ItemGroup>

</Project>
