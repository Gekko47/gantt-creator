<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!--
      NETSDK1100: allow resolving the Windows targeting pack when building
      on a non-Windows host (no-op on Windows builds).
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>GanttCreator.Office</RootNamespace>
    <AssemblyName>GanttCreator.Office</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ExcelDna.Interop" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GanttCreator.Core\GanttCreator.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The documented test seams on the Excel adapters are internal virtual members;
         the contract tests subclass them to prove the bulk-write behaviour without COM. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>GanttCreator.Office.ContractTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
