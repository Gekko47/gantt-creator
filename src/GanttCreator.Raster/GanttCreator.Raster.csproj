<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!--
      NETSDK1100: allow resolving the Windows targeting pack when building
      on a non-Windows host (no-op on Windows builds).
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>GanttCreator.Raster</RootNamespace>
    <AssemblyName>GanttCreator.Raster</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!--
      No Excel interop: ExportSize is pure size arithmetic over
      System.Globalization. The Raster project is an offline export-size helper
      and must not drag the Office PIA into the render pipeline (ADR-0004
      pins the interop package to the Office adapter only).
    -->
    <ProjectReference Include="..\GanttCreator.Core\GanttCreator.Core.csproj" />
  </ItemGroup>
</Project>
