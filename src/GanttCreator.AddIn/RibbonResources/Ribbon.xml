<?xml version="1.0" encoding="utf-8" ?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnLoad">
  <ribbon>
    <tabs>
      <tab id="tabGanttCreator" label="Gantt Creator">
        <!-- R5.9 presentation delta: every actionable control carries a unique
             keytip plus a screentip and supertip (the accessible description a
             screen reader announces), and every button carries a visible label.
             Supertips are local text only — no network links anywhere, per the
             offline invariant. -->
        <group id="grpData" label="Data">
          <button id="btnInitialiseSheet" label="Initialise sheet" imageMso="TableInsertExcel" keytip="I" screentip="Initialise the Gantt sheet" supertip="Creates the Gantt table, the chart area, and the workbook configuration. Run it once per workbook before adding activities." getEnabled="GetEnabled" onAction="OnInitialiseSheetClick"/>
          <button id="btnValidateSheet" label="Validate" imageMso="Spelling" keytip="V" screentip="Validate the schedule table" supertip="Checks every row and reports errors and warnings as cell notes. Validation never changes your schedule data." getEnabled="GetEnabled" onAction="OnValidateSheetClick"/>
          <button id="btnRepairConfig" label="Repair configuration" imageMso="TableInsertExcel" keytip="R" screentip="Repair the configuration" supertip="Checks the hidden configuration sheet and repairs safe damage. A repair that could touch visible schedule rows asks for confirmation first." getEnabled="GetEnabled" onAction="OnRepairConfigClick"/>
          <button id="btnAddActivity" label="Add activity" imageMso="TableInsertExcel" keytip="AA" screentip="Add an activity row" supertip="Appends a new activity row below the table and places the cursor in it." getEnabled="GetEnabled" onAction="OnAddActivityClick"/>
          <button id="btnAddMilestone" label="Add milestone" imageMso="TableInsertExcel" keytip="AM" screentip="Add a milestone row" supertip="Appends a new milestone row. A milestone plots from its Start date only." getEnabled="GetEnabled" onAction="OnAddMilestoneClick"/>
          <button id="btnAddDelineator" label="Add delineator" imageMso="TableInsertExcel" keytip="AD" screentip="Add a delineator row" supertip="Appends a new delineator row. A delineator draws a full-height line at its Start date." getEnabled="GetEnabled" onAction="OnAddDelineatorClick"/>
          <!-- R5.3 WI-E: add a CHILD under the selected parent. The dropdown is
               populated from the hierarchy catalogue, so it offers exactly the
               child types the selected parent may take, and the planner accepts
               every one of them. It is a dropDown rather than a menu because
               Excel-DNA 1.9 exposes no IRibbonMenu type, so a getMenu callback
               cannot be bound. -->
          <dropDown id="ddnAddChild" label="Add child" keytip="AC" screentip="Add a child row" supertip="Adds a row beneath the selected parent, using a type the parent may own. The list offers only permitted child types." getEnabled="GetEnabled" getItemCount="GetAddChildCount" getItemID="GetAddChildItemID" getItemLabel="GetAddChildItemLabel" onAction="OnAddChildChange"/>
          <button id="btnRemove" label="Remove" imageMso="TableInsertExcel" keytip="X" screentip="Remove the selected row" supertip="Deletes the selected row and re-homes its children. A confirmation is shown unless you opted out this session." getEnabled="GetEnabled" onAction="OnRemoveClick"/>
        </group>
        <group id="grpOrdering" label="Ordering">
          <box id="boxOrdering" boxStyle="vertical">
            <button id="btnPromoteToParent" label="Promote to parent" imageMso="TableInsertExcel" keytip="P" screentip="Promote the row to top level" supertip="Moves the selected row out of its group and resequences the top-level rows." getEnabled="GetEnabled" onAction="OnPromoteToParentClick"/>
            <button id="btnDemoteToChild" label="Demote to child" imageMso="TableInsertExcel" keytip="E" screentip="Demote the row under the group above" supertip="Moves the selected row into the group above it and re-homes its own children." getEnabled="GetEnabled" onAction="OnDemoteToChildClick"/>
            <!-- TODO(R5.10): getEnabled on both move buttons is workbook+initialised only. Once the
                 add-in tracks the active cell (R5.10 cell tracking), gate these on a resolved table
                 body selection and disable them at the top/bottom of the selection's set, so a
                 boundary no-op cannot be requested from the ribbon. Until then the command is a
                 quiet no-op by design (R5.4 D4). -->
            <box id="boxMoveRows" boxStyle="horizontal">
              <button id="btnMoveUp" label="Up" imageMso="TableInsertExcel" keytip="U" screentip="Move the row up" supertip="Swaps the selected row with the row above. At the top of the table the command does nothing." getEnabled="GetEnabled" onAction="OnMoveUpClick"/>
              <button id="btnMoveDown" label="Down" imageMso="TableInsertExcel" keytip="N" screentip="Move the row down" supertip="Swaps the selected row with the row below. At the bottom of the table the command does nothing." getEnabled="GetEnabled" onAction="OnMoveDownClick"/>
            </box>
          </box>
        </group>
        <group id="grpOutline" label="Outline">
          <!-- R5.4: the Ribbon surface over the native Excel outline. These
               buttons collapse and expand EVERY parent/child group at once,
               which is the one thing Excel's per-group -/+ controls cannot do.
               They write the same state the native control writes (the child
               rows' hidden flag), so the result is indistinguishable from
               pressing the native control on each group. -->
          <box id="boxOutlineGroups" boxStyle="horizontal">
            <button id="btnExpandAllGroups" label="Expand all groups" imageMso="OutlineExpand" keytip="G" screentip="Expand every outline group" supertip="Shows every grouped child row. The chart is unchanged because hidden rows still keep their place." getEnabled="GetEnabled" onAction="OnExpandAllGroupsClick"/>
            <button id="btnCollapseAllGroups" label="Collapse all groups" imageMso="OutlineCollapse" keytip="C" screentip="Collapse every outline group" supertip="Hides every grouped child row using the same row state as Excel's own outline controls." getEnabled="GetEnabled" onAction="OnCollapseAllGroupsClick"/>
          </box>
        </group>
        <group id="grpLabels" label="Labels">
          <!-- R5.5: dynamic item lists — items are projected from the selected
               row's Type (EntityTypeCatalog) at query time, so no option list
               is authored twice. R5.10 adds fill/stroke into this group. -->
          <box id="boxDescriptionLabel" boxStyle="horizontal">
            <labelControl id="lblDescriptionLabel" label="Description label"/>
            <dropDown id="ddnDescriptionLabel" keytip="DL" screentip="Description label position" supertip="Places the description label for the selected row. The list offers only positions the row's type permits." getEnabled="GetEnabled" getItemCount="GetDescriptionLabelCount" getItemID="GetDescriptionLabelItemID" getItemLabel="GetDescriptionLabelItemLabel" getSelectedItemIndex="GetDescriptionLabelSelectedIndex" onAction="OnDescriptionLabelChange"/>
          </box>
          <!-- R5.14: the parallel date-label dropdown. Its items are the
               selected row's allowed date-label choices (projected from the
               row's Type), led by Auto, which clears the cell. The capability
               is type-only, so no option list is authored twice. -->
          <box id="boxDateLabel" boxStyle="horizontal">
            <labelControl id="lblDateLabel" label="Date label"/>
            <dropDown id="ddnDateLabel" keytip="DT" screentip="Date label choice" supertip="Chooses which date label the selected row shows. A delineator chooses a label corner instead." getEnabled="GetEnabled" getItemCount="GetDateLabelCount" getItemID="GetDateLabelItemID" getItemLabel="GetDateLabelItemLabel" getSelectedItemIndex="GetDateLabelSelectedIndex" onAction="OnDateLabelChange"/>
          </box>
          <!-- R5.6a: the custom-style dropdown. Its items are the
               user-created (non-built-in) style keys of the configuration
               registry, projected at query time, so no option list is
               authored anywhere. It enables only for a single Custom
               Activity / Custom Milestone row with at least one custom
               style defined; picking an item writes that row's hidden
               StyleKey cell (Refresh applies the visual change). -->
          <box id="boxCustomStyle" boxStyle="horizontal">
            <labelControl id="lblCustomStyle" label="Custom style"/>
            <dropDown id="ddnCustomStyle" keytip="CS" screentip="Custom style for the row" supertip="Assigns a custom style to the selected Custom Activity or Custom Milestone row." getEnabled="GetEnabled" getItemCount="GetCustomStyleCount" getItemID="GetCustomStyleItemID" getItemLabel="GetCustomStyleItemLabel" getSelectedItemIndex="GetCustomStyleSelectedIndex" onAction="OnCustomStyleChange"/>
          </box>
        </group>
        <group id="grpStyleTheme" label="Style and Theme">
          <button id="btnThemeSettings" label="Theme settings..." keytip="T" screentip="Open the theme settings" supertip="Edits entity styles, chart chrome, and custom styles. Changes apply to the chart after they are saved." getEnabled="GetEnabled" onAction="OnThemeSettingsClick"/>
          <button id="btnChartTitle" label="Chart title..." keytip="H" screentip="Edit the chart title" supertip="Sets the title shown above the Gantt chart. Clearing the title hides it." getEnabled="GetEnabled" onAction="OnChartTitleClick"/>
        </group>
        <group id="grpPlotArea" label="Plot Area">
          <box id="boxPlotStart" boxStyle="vertical">
            <labelControl id="lblPlotStartDate" label="Start Date"/>
            <box id="boxPlotStartAuto" boxStyle="horizontal">
              <labelControl id="lblPlotStartAuto" label="Auto"/>
              <checkBox id="chkPlotStartAuto" keytip="SA" screentip="Automatic start date" supertip="Lets the chart start at the first activity. Uncheck to type an explicit start date." getPressed="GetPlotStartAuto" onAction="OnPlotStartAutoClick"/>
            </box>
            <editBox id="edtPlotStartDate" keytip="SD" screentip="Explicit start date" supertip="The chart start date in dd/mm/yyyy form. It is disabled while the automatic start is checked." getText="GetPlotStartDate" getEnabled="GetPlotStartDateEnabled" onChange="OnPlotStartDateChange" sizeString="dd-mmm-yy"/>
          </box>
          <box id="boxPlotFinish" boxStyle="vertical">
            <labelControl id="lblPlotFinishDate" label="Finish Date"/>
            <box id="boxPlotFinishAuto" boxStyle="horizontal">
              <labelControl id="lblPlotFinishAuto" label="Auto"/>
              <checkBox id="chkPlotFinishAuto" keytip="FA" screentip="Automatic finish date" supertip="Lets the chart end at the last activity. Uncheck to type an explicit finish date." getPressed="GetPlotFinishAuto" onAction="OnPlotFinishAutoClick"/>
            </box>
            <editBox id="edtPlotFinishDate" keytip="FD" screentip="Explicit finish date" supertip="The chart finish date in dd/mm/yyyy form. It is disabled while the automatic finish is checked." getText="GetPlotFinishDate" getEnabled="GetPlotFinishDateEnabled" onChange="OnPlotFinishDateChange" sizeString="dd-mmm-yy"/>
          </box>
        </group>
        <group id="grpPlotTimeScale" label="Plot Time Scale">
          <dropDown id="ddnPlotTimeScale" label="Time scale" keytip="K" screentip="Chart time scale" supertip="Chooses the month, quarter, or week scale and the month label form. The chart redraws after the choice is saved." getSelectedItemIndex="GetTimeScale" getEnabled="GetEnabled" onAction="OnTimeScaleChange">
            <item id="Month-MM" label="Month (MM)"/>
            <item id="Month-MMM" label="Month (MMM)"/>
            <item id="Quarter" label="Quarter"/>
            <item id="Week" label="Week"/>
          </dropDown>
        </group>
        <group id="grpPlotSize" label="Plot Size">
          <box id="boxPresets" boxStyle="vertical">
            <box id="boxPresetsA4" boxStyle="vertical">
              <button id="btnPresetA4Portrait" label="A4 portrait" imageMso="PageOrientationPortrait" keytip="1" screentip="A4 portrait page" supertip="Sizes the chart for an A4 portrait page." getEnabled="GetEnabled" onAction="OnPresetClick"/>
              <button id="btnPresetA4Landscape" label="A4 landscape" imageMso="PageOrientationLandscape" keytip="2" screentip="A4 landscape page" supertip="Sizes the chart for an A4 landscape page." getEnabled="GetEnabled" onAction="OnPresetClick"/>
              <box id="boxPresetsPresentation" boxStyle="horizontal">
                <button id="btnPresetPresentation16x9" label="16:9" imageMso="PageOrientationLandscape" keytip="3" screentip="16:9 slide" supertip="Sizes the chart for a 16:9 presentation slide." getEnabled="GetEnabled" onAction="OnPresetClick"/>
                <button id="btnPresetPresentation4x3" label="4:3" imageMso="PageOrientationPortrait" keytip="4" screentip="4:3 slide" supertip="Sizes the chart for a 4:3 presentation slide." getEnabled="GetEnabled" onAction="OnPresetClick"/>
              </box>
            </box>
          </box>
          <box id="boxMargin" boxStyle="vertical">
            <labelControl id="lblMargin" label="Margin"/>
            <dropDown id="ddnMargin" keytip="M" screentip="Page margin" supertip="Chooses the chart page margin. Custom uses the centimetre value beside it." getSelectedItemIndex="GetMargin" getEnabled="GetEnabled" onAction="OnMarginChange">
              <item id="Narrow" label="Narrow (0.635 cm)"/>
              <item id="Normal" label="Normal (1.78 cm)"/>
              <item id="Wide" label="Wide (2.54 cm)"/>
              <item id="Custom" label="Custom"/>
            </dropDown>
            <box id="boxMarginCm" boxStyle="horizontal">
              <editBox id="edtMarginCm" keytip="MC" screentip="Custom margin in centimetres" supertip="The custom page margin in centimetres. It applies when the margin choice is Custom." getText="GetMarginCm" getEnabled="GetMarginCmEnabled" onChange="OnMarginCmChange" sizeString="0.00"/>
              <labelControl id="lblMarginUnit" label="(cm)"/>
            </box>
          </box>
          <box id="boxPlotDimensions" boxStyle="vertical">
            <labelControl id="lblPlotDimensions" label="Dimensions"/>
            <box id="boxPlotWidth" boxStyle="horizontal">
              <labelControl id="lblPlotWidth" label="Width"/>
              <editBox id="edtPlotWidth" keytip="W" screentip="Plot width in points" supertip="Shows the measured plot width. This value is read-only." getText="GetPlotWidth" getEnabled="GetPlotDimensionsEnabled" sizeString="0.00"/>
              <labelControl id="lblPlotWidthUnit" label="(pt)"/>
            </box>
            <box id="boxPlotHeight" boxStyle="horizontal">
              <labelControl id="lblPlotHeight" label="Height"/>
              <editBox id="edtPlotHeight" keytip="Z" screentip="Plot height in points" supertip="Shows the measured plot height. This value is read-only." getText="GetPlotHeight" getEnabled="GetPlotDimensionsEnabled" sizeString="0.00"/>
              <labelControl id="lblPlotHeightUnit" label="(pt)"/>
            </box>
          </box>
        </group>
        <group id="grpPlaceholder" label="Gantt Creator">
          <button id="btnRefreshSheet" label="Refresh chart" imageMso="Refresh" keytip="F" screentip="Refresh the Gantt chart" supertip="Rebuilds the chart from the whole table. Edits also refresh automatically after a short pause." getEnabled="GetEnabled" onAction="OnRefreshSheetClick"/>
          <button id="btnWarnings" label="Warnings..." keytip="WN" screentip="Open the warnings list" supertip="Lists warnings from the last chart render and the current validation findings. The list is read-only." getEnabled="GetEnabled" onAction="OnWarningsClick"/>
          <!-- ADR-0055: the chart's shapes are locked while the sheet is protected. Unlock acts on
               ONE selected shape the add-in drew, releases the protection so it can be dragged, and
               suspends the automatic refresh until Lock shapes or an explicit Refresh puts it back. -->
          <button id="btnUnlockShape" label="Unlock shape" keytip="UL" screentip="Unlock the selected shape" supertip="Lets you drag the selected chart shape. Automatic refresh pauses until you lock the shapes again or refresh the chart." getEnabled="GetEnabled" onAction="OnUnlockShapeClick"/>
          <button id="btnLockShapes" label="Lock shapes" keytip="LK" screentip="Lock every chart shape" supertip="Re-locks every chart shape and restores the chart's protection. A manual edit is reverted by the next refresh." getEnabled="GetEnabled" onAction="OnLockShapesClick"/>
        </group>
        <group id="grpDiagnostics" label="Diagnostics">
          <button id="btnDiagnostics" label="Diagnostics" imageMso="Help" keytip="D" screentip="Show diagnostics" supertip="Shows the add-in version, Office version, and bitness, with a link to the log file." getEnabled="GetEnabled" onAction="OnDiagnosticsClick"/>
          <button id="btnOpenLog" label="Open log file" imageMso="FileOpen" keytip="L" screentip="Open the log file" supertip="Opens the add-in log in your default text editor." getEnabled="GetEnabled" onAction="OnOpenLogClick"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
