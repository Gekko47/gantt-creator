<?xml version="1.0" encoding="utf-8" ?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnLoad">
  <ribbon>
    <tabs>
      <tab id="tabGanttCreator" label="Gantt Creator">
        <!-- R5.9 presentation delta: every actionable control carries a unique
             keytip plus a screentip and supertip (the accessible description a
             screen reader announces), and every button carries a visible label.
             Supertips are local text only — no network links anywhere, per the
             offline invariant. -->
        <!-- R5.16: the first-run surface. Visible only while the workbook has
             no add-in configuration; see RibbonState.IsVisible and ADR-0056.
             Diagnostics stays visible in every mode (owner ruling 2026-11-10). -->
        <group id="grpGetStarted" label="Get started" getVisible="GetVisible">
          <button id="btnInitialiseSheet" label="Initialise sheet" size="large" imageMso="TableInsertExcel" keytip="I" screentip="Initialise the Gantt sheet" supertip="Creates the Gantt table, the chart area, and the workbook configuration. Run it once per workbook before adding activities." getEnabled="GetEnabled" onAction="OnInitialiseSheetClick"/>
        </group>
        <!-- R5.16a: the Data group keeps its owner-tooled five large controls.
             Only the two labels (Repair, Elements) and the per-control glyphs
             changed; ids, menus, keytips and actions are unchanged. -->
        <group id="grpData" label="Data" getVisible="GetVisible">
          <splitButton id="spbFix" size="large" getEnabled="GetEnabled">
            <button id="btnRepairConfig" label="Repair" imageMso="DataValidation" keytip="R" screentip="Repair the configuration" supertip="Checks the hidden configuration sheet and repairs safe damage. A repair that could touch visible schedule rows asks for confirmation first." getEnabled="GetEnabled" onAction="OnRepairConfigClick"/>
            <menu id="mnuFix">
              <button id="btnValidateSheet" label="Validate" imageMso="DataValidationCircleInvalid" keytip="QV" screentip="Validate the schedule table" supertip="Checks every row and reports errors and warnings as cell notes. Validation never changes your schedule data." getEnabled="GetEnabled" onAction="OnValidateSheetClick"/>
            </menu>
          </splitButton>

          <splitButton id="spbAddActivity" size="large" getEnabled="GetEnabled">
            <button id="btnAddActivity" label="Add activity" imageMso="TableRowsInsertAboveExcel" keytip="AA" screentip="Add an activity row" supertip="Adds the default As-Planned Activity. Open the list for every activity type." getEnabled="GetEnabled" onAction="OnAddActivityClick"/>
            <menu id="mnuAddActivity">
              <button id="entAsPlannedActivity" getLabel="GetEntityMenuLabel" keytip="AP" screentip="Add an As-Planned Activity" supertip="Adds an as-planned activity row." onAction="OnAddEntityClick"/>
              <button id="entAsBuiltActivity" getLabel="GetEntityMenuLabel" keytip="AB" screentip="Add an As-Built Activity" supertip="Adds an as-built activity row." onAction="OnAddEntityClick"/>
              <button id="entBaselineActivity" getLabel="GetEntityMenuLabel" keytip="AL" screentip="Add a Baseline Activity" supertip="Adds a baseline activity row." onAction="OnAddEntityClick"/>
              <button id="entCustomActivity" getLabel="GetEntityMenuLabel" keytip="AU" screentip="Add a Custom Activity" supertip="Adds a custom activity row; its style key is chosen in the Labels group." onAction="OnAddEntityClick"/>
              <button id="entDelayEvent" getLabel="GetEntityMenuLabel" keytip="AV" screentip="Add a Delay Event" supertip="Adds a delay event row under an activity." onAction="OnAddEntityClick"/>
              <button id="entCriticalInterval" getLabel="GetEntityMenuLabel" getEnabled="GetCriticalIntervalEnabled" keytip="AI" screentip="Add a Critical Interval" supertip="Adds a critical interval under the nearest activity that can own it. Disabled when no row can own one." onAction="OnAddEntityClick"/>
              <menuSeparator id="sepProcurement" title="Procurement"/>
              <button id="entAsPlannedProcurement" getLabel="GetEntityMenuLabel" keytip="AQ" screentip="Add an As-Planned Procurement row" supertip="Adds an as-planned procurement row." onAction="OnAddEntityClick"/>
              <button id="entAsBuiltProcurement" getLabel="GetEntityMenuLabel" keytip="AR" screentip="Add an As-Built Procurement row" supertip="Adds an as-built procurement row." onAction="OnAddEntityClick"/>
              <button id="entBaselineProcurement" getLabel="GetEntityMenuLabel" keytip="AS" screentip="Add a Baseline Procurement row" supertip="Adds a baseline procurement row." onAction="OnAddEntityClick"/>
            </menu>
          </splitButton>

          <splitButton id="spbAddMilestone" size="large" getEnabled="GetEnabled">
            <button id="btnAddMilestone" label="Add milestone" imageMso="CalendarInsert" keytip="AM" screentip="Add a milestone row" supertip="Adds the default As-Planned Milestone. Open the list for every milestone type." getEnabled="GetEnabled" onAction="OnAddMilestoneClick"/>
            <menu id="mnuAddMilestone">
              <button id="entAsPlannedMilestone" getLabel="GetEntityMenuLabel" keytip="BP" screentip="Add an As-Planned Milestone" supertip="Adds an as-planned milestone row. A milestone plots from its Start date only." onAction="OnAddEntityClick"/>
              <button id="entAsBuiltMilestone" getLabel="GetEntityMenuLabel" keytip="BB" screentip="Add an As-Built Milestone" supertip="Adds an as-built milestone row." onAction="OnAddEntityClick"/>
              <button id="entBaselineMilestone" getLabel="GetEntityMenuLabel" keytip="BL" screentip="Add a Baseline Milestone" supertip="Adds a baseline milestone row." onAction="OnAddEntityClick"/>
              <button id="entCriticalMilestone" getLabel="GetEntityMenuLabel" keytip="BI" screentip="Add a Critical Milestone" supertip="Adds a critical milestone row." onAction="OnAddEntityClick"/>
              <button id="entCustomMilestone" getLabel="GetEntityMenuLabel" keytip="BU" screentip="Add a Custom Milestone" supertip="Adds a custom milestone row; its style key is chosen in the Labels group." onAction="OnAddEntityClick"/>
            </menu>
          </splitButton>

          <splitButton id="spbAddElements" size="large" getEnabled="GetEnabled">
            <button id="btnAddDelineator" label="Elements" imageMso="ShapesInsertGallery" keytip="AD" screentip="Add a delineator or a structural row" supertip="Adds the default Delineator. Open the list for a spacer or a splitter." getEnabled="GetEnabled" onAction="OnAddDelineatorClick"/>
            <menu id="mnuAddElements">
              <button id="entDelineator" getLabel="GetEntityMenuLabel" keytip="JD" screentip="Add a Delineator" supertip="Adds a delineator row. A delineator draws a full-height line at its Start date." onAction="OnAddEntityClick"/>
              <button id="entSpacer" getLabel="GetEntityMenuLabel" keytip="JS" screentip="Add a Spacer" supertip="Adds a spacer row that separates sections of the table." onAction="OnAddEntityClick"/>
              <button id="entSplitter" getLabel="GetEntityMenuLabel" keytip="JP" screentip="Add a Splitter" supertip="Adds a splitter band that separates sections of the table." onAction="OnAddEntityClick"/>
            </menu>
          </splitButton>

          <button id="btnRemove" label="Remove" size="large" imageMso="TableRowsDeleteExcel" keytip="X" screentip="Remove the selected row" supertip="Deletes the selected row and re-homes its children. A confirmation is shown unless you opted out this session." getEnabled="GetEnabled" onAction="OnRemoveClick"/>
        </group>
        <!-- R5.16a: Ordering and Outline are one group. Promote and Demote are
             Excel's own outline group/ungroup operations, and Up/Down reorder
             the row inside its sibling run, so they read as one subject. A
             two-wide, three-storey grid keeps the group narrow. -->
        <group id="grpOutline" label="Outline" getVisible="GetVisible">
          <box id="boxOutlineRow1" boxStyle="horizontal">
            <button id="btnPromoteToParent" label="Promote" imageMso="OutlineUngroup" keytip="P" screentip="Promote the row to top level" supertip="Moves the selected row out of its group and resequences the top-level rows." getEnabled="GetEnabled" onAction="OnPromoteToParentClick"/>
            <button id="btnDemoteToChild" label="Demote" imageMso="OutlineGroup" keytip="E" screentip="Demote the row under the group above" supertip="Moves the selected row into the group above it and re-homes its own children." getEnabled="GetEnabled" onAction="OnDemoteToChildClick"/>
          </box>
          <!-- TODO(R5.10): Up/Down are gated on workbook + initialised only. Once the add-in
               tracks the active cell (R5.10 cell tracking), gate them on a resolved table body
               selection so a boundary no-op cannot be requested from the ribbon. -->
          <box id="boxOutlineRow2" boxStyle="horizontal">
            <button id="btnMoveUp" label="Up" imageMso="SortAscendingExcel" keytip="U" screentip="Move the row up" supertip="Swaps the selected row with the row above. At the top of the table the command does nothing." getEnabled="GetEnabled" onAction="OnMoveUpClick"/>
            <button id="btnMoveDown" label="Down" imageMso="SortDescendingExcel" keytip="N" screentip="Move the row down" supertip="Swaps the selected row with the row below. At the bottom of the table the command does nothing." getEnabled="GetEnabled" onAction="OnMoveDownClick"/>
          </box>
          <box id="boxOutlineRow3" boxStyle="horizontal">
            <button id="btnExpandAllGroups" label="Expand all" imageMso="OutlineExpand" keytip="G" screentip="Expand every outline group" supertip="Shows every grouped child row. The chart is unchanged because hidden rows still keep their place." getEnabled="GetEnabled" onAction="OnExpandAllGroupsClick"/>
            <button id="btnCollapseAllGroups" label="Collapse all" imageMso="OutlineCollapse" keytip="C" screentip="Collapse every outline group" supertip="Hides every grouped child row using the same row state as Excel's own outline controls." getEnabled="GetEnabled" onAction="OnCollapseAllGroupsClick"/>
          </box>
        </group>
        <group id="grpLabels" label="Labels" getVisible="GetVisible">
          <!-- R5.5: dynamic item lists — items are projected from the selected
               row's Type (EntityTypeCatalog) at query time, so no option list
               is authored twice. The captions are short because the group label
               already supplies the context. -->
          <box id="boxDescriptionLabel" boxStyle="horizontal">
            <labelControl id="lblDescriptionLabel" label="Description"/>
            <dropDown id="ddnDescriptionLabel" keytip="DL" screentip="Description label position" supertip="Places the description label for the selected row. The list offers only positions the row's type permits." getEnabled="GetEnabled" getItemCount="GetDescriptionLabelCount" getItemID="GetDescriptionLabelItemID" getItemLabel="GetDescriptionLabelItemLabel" getSelectedItemIndex="GetDescriptionLabelSelectedIndex" onAction="OnDescriptionLabelChange"/>
          </box>
          <box id="boxDateLabel" boxStyle="horizontal">
            <labelControl id="lblDateLabel" label="Date"/>
            <dropDown id="ddnDateLabel" keytip="DT" screentip="Date label choice" supertip="Chooses which date label the selected row shows. A delineator chooses a label corner instead." getEnabled="GetEnabled" getItemCount="GetDateLabelCount" getItemID="GetDateLabelItemID" getItemLabel="GetDateLabelItemLabel" getSelectedItemIndex="GetDateLabelSelectedIndex" onAction="OnDateLabelChange"/>
          </box>
          <box id="boxCustomStyle" boxStyle="horizontal">
            <labelControl id="lblCustomStyle" label="Style"/>
            <dropDown id="ddnCustomStyle" keytip="CS" screentip="Custom style for the row" supertip="Assigns a custom style to the selected Custom Activity or Custom Milestone row." getEnabled="GetEnabled" getItemCount="GetCustomStyleCount" getItemID="GetCustomStyleItemID" getItemLabel="GetCustomStyleItemLabel" getSelectedItemIndex="GetCustomStyleSelectedIndex" onAction="OnCustomStyleChange"/>
          </box>
        </group>
        <group id="grpStyleTheme" label="Style" getVisible="GetVisible">
          <button id="btnThemeSettings" label="Theme settings..." imageMso="ThemesGallery" keytip="T" screentip="Open the theme settings" supertip="Edits entity styles, chart chrome, and custom styles. Changes apply to the chart after they are saved." getEnabled="GetEnabled" onAction="OnThemeSettingsClick"/>
          <button id="btnChartTitle" label="Chart title..." imageMso="ChartTitle" keytip="H" screentip="Edit the chart title" supertip="Sets the title shown above the Gantt chart. Clearing the title hides it." getEnabled="GetEnabled" onAction="OnChartTitleClick"/>
        </group>
        <!-- R5.16a: Plot Area and Plot Time Scale were one subject split across
             two groups. They are now one "Chart" group with a per-date row.
             Width and height are outputs, so they render as labels rather than
             disabled edit boxes. -->
        <group id="grpPlotArea" label="Chart" getVisible="GetVisible">
          <box id="boxPlotStart" boxStyle="horizontal">
            <labelControl id="lblPlotStartDate" label="Start"/>
            <editBox id="edtPlotStartDate" keytip="SD" screentip="Explicit start date" supertip="The chart start date in dd/mm/yyyy form. It is disabled while the automatic start is checked." getText="GetPlotStartDate" getEnabled="GetPlotStartDateEnabled" onChange="OnPlotStartDateChange" sizeString="dd-mmm-yy"/>
            <checkBox id="chkPlotStartAuto" label="Auto" keytip="SA" screentip="Automatic start date" supertip="Lets the chart start at the first activity. Uncheck to type an explicit start date." getPressed="GetPlotStartAuto" getEnabled="GetEnabled" onAction="OnPlotStartAutoClick"/>
          </box>
          <box id="boxPlotFinish" boxStyle="horizontal">
            <labelControl id="lblPlotFinishDate" label="Finish"/>
            <editBox id="edtPlotFinishDate" keytip="FD" screentip="Explicit finish date" supertip="The chart finish date in dd/mm/yyyy form. It is disabled while the automatic finish is checked." getText="GetPlotFinishDate" getEnabled="GetPlotFinishDateEnabled" onChange="OnPlotFinishDateChange" sizeString="dd-mmm-yy"/>
            <checkBox id="chkPlotFinishAuto" label="Auto" keytip="FA" screentip="Automatic finish date" supertip="Lets the chart end at the last activity. Uncheck to type an explicit finish date." getPressed="GetPlotFinishAuto" getEnabled="GetEnabled" onAction="OnPlotFinishAutoClick"/>
          </box>
          <box id="boxPlotTimeScale" boxStyle="horizontal">
            <labelControl id="lblPlotTimeScale" label="Scale"/>
            <dropDown id="ddnPlotTimeScale" keytip="K" screentip="Chart time scale" supertip="Chooses the month, quarter, or week scale and the month label form. The chart redraws after the choice is saved." getSelectedItemIndex="GetTimeScale" getEnabled="GetEnabled" onAction="OnTimeScaleChange">
              <item id="Month-MM" label="Month (MM)"/>
              <item id="Month-MMM" label="Month (MMM)"/>
              <item id="Quarter" label="Quarter"/>
              <item id="Week" label="Week"/>
            </dropDown>
          </box>
        </group>
        <group id="grpPlotSize" label="Size" getVisible="GetVisible">
          <!-- R5.16a: the four preset buttons are one dropdown that also shows
               the current preset. Item ids are the durable SizePreset keys. -->
          <box id="boxSizePreset" boxStyle="horizontal">
            <labelControl id="lblSize" label="Size"/>
            <dropDown id="ddnSize" keytip="SZ" screentip="Output size" supertip="Chooses the page or slide size the chart is generated for. The current size is shown." getSelectedItemIndex="GetSize" getEnabled="GetEnabled" onAction="OnSizeChange">
              <item id="A4Portrait" label="A4 (portrait)" imageMso="PageOrientationPortrait"/>
              <item id="A4Landscape" label="A4 (landscape)" imageMso="PageOrientationLandscape"/>
              <item id="Presentation16x9" label="Presentation 16:9" imageMso="PageOrientationLandscape"/>
              <item id="Presentation4x3" label="Presentation 4:3" imageMso="PageOrientationPortrait"/>
            </dropDown>
          </box>
          <box id="boxMargin" boxStyle="horizontal">
            <labelControl id="lblMargin" label="Margin"/>
            <dropDown id="ddnMargin" keytip="M" screentip="Page margin" supertip="Chooses the chart page margin. Custom uses the centimetre value beside it." getSelectedItemIndex="GetMargin" getEnabled="GetEnabled" onAction="OnMarginChange">
              <item id="Narrow" label="Narrow (0.635 cm)"/>
              <item id="Normal" label="Normal (1.78 cm)"/>
              <item id="Wide" label="Wide (2.54 cm)"/>
              <item id="Custom" label="Custom"/>
            </dropDown>
            <editBox id="edtMarginCm" keytip="MC" screentip="Custom margin in centimetres" supertip="The custom page margin in centimetres. It applies when the margin choice is Custom." getText="GetMarginCm" getEnabled="GetMarginCmEnabled" onChange="OnMarginCmChange" sizeString="0.00"/>
            <labelControl id="lblMarginUnit" label="cm"/>
          </box>
          <box id="boxPlotDimensions" boxStyle="horizontal">
            <labelControl id="lblPlotWidth" getLabel="GetPlotWidthLabel"/>
            <labelControl id="lblPlotHeight" getLabel="GetPlotHeightLabel"/>
          </box>
        </group>
        <!-- R5.16a: the group previously labelled "Gantt Creator" (id
             grpPlaceholder) is the sheet/chart maintenance group. It is now
             "Sheet" and laid out as a 2 x 2 grid. -->
        <group id="grpSheet" label="Sheet" getVisible="GetVisible">
          <box id="boxSheetRow1" boxStyle="horizontal">
            <button id="btnRefreshSheet" label="Refresh chart" imageMso="RefreshAll" keytip="F" screentip="Refresh the Gantt chart" supertip="Rebuilds the chart from the whole table. Edits also refresh automatically after a short pause." getEnabled="GetEnabled" onAction="OnRefreshSheetClick"/>
            <button id="btnWarnings" label="Warnings..." imageMso="ErrorChecking" keytip="WN" screentip="Open the warnings list" supertip="Lists warnings from the last chart render and the current validation findings. The list is read-only." getEnabled="GetEnabled" onAction="OnWarningsClick"/>
          </box>
          <box id="boxSheetRow2" boxStyle="horizontal">
            <!-- ADR-0055: the chart's shapes are locked while the sheet is protected. Unlock acts on
                 ONE selected shape the add-in drew, releases the protection so it can be dragged, and
                 suspends the automatic refresh until Lock shapes or an explicit Refresh puts it back. -->
            <toggleButton id="btnToggleChartLock" label="Lock chart" keytip="LK" screentip="Lock or unlock the chart elements" supertip="Pressed means the chart's shapes are locked and cannot be dragged. Unpressed means you can move them; the automatic refresh pauses until you lock the chart again or refresh." imageMso="Lock" getEnabled="GetEnabled" getPressed="GetToggleChartLockPressed" onAction="OnToggleChartLockClick"/>
            <toggleButton id="btnToggleCellLock" label="Lock cells" keytip="CL" screentip="Lock or unlock the cells outside the table" supertip="Pressed means the cells outside the visible table are read-only. Unpressed means the whole sheet is editable. The visible table is always editable either way, so copy, paste and formatting are never blocked there." imageMso="LockCell" getEnabled="GetEnabled" getPressed="GetToggleCellLockPressed" onAction="OnToggleCellLockClick"/>
          </box>
        </group>
        <group id="grpDiagnostics" label="Diagnostics" getVisible="GetVisible">
          <button id="btnDiagnostics" label="Diagnostics" imageMso="Help" keytip="D" screentip="Show diagnostics" supertip="Shows the add-in version, Office version, and bitness, with a link to the log file." getEnabled="GetEnabled" onAction="OnDiagnosticsClick"/>
          <button id="btnOpenLog" label="Open log file" imageMso="FileOpen" keytip="L" screentip="Open the log file" supertip="Opens the add-in log in your default text editor." getEnabled="GetEnabled" onAction="OnOpenLogClick"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
