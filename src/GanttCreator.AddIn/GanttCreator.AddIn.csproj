<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>GanttCreator.AddIn</RootNamespace>
    <AssemblyName>GanttCreator.AddIn</AssemblyName>
    <!--
      The assembly embeds RibbonResources.resx (the RibbonX document), so it
      must declare its neutral language (CA1824). The Ribbon labels are
      English; the SDK emits System.Resources.NeutralResourcesLanguageAttribute
      from this property. See the CA1824 docs for the package/deploy probe
      rationale.
    -->
    <NeutralLanguage>en-US</NeutralLanguage>
    <ExcelDnaPackageVersion>1.9.0</ExcelDnaPackageVersion>
    <!--
      The Diagnostics command shows a managed WinForms TaskDialog with a
      hyperlink to the active log file (System.Windows.Forms.TaskDialog,
      .NET 5+). UseWindowsForms is part of the net10.0-windows desktop
      runtime already loaded by the Excel host — it imports the .NET Desktop
      SDK and adds no NuGet dependency. The managed API replaces the previous
      hand-rolled comctl32 P/Invoke, which failed with
      EntryPointNotFoundException (GetDesktopWindow lives in user32.dll;
      comctl32 v6 exports TaskDialogIndirect only by ordinal 121). See
      docs/work-items/R1.3-diagnostics-command.md.
    -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ExcelDna.AddIn" />
    <PackageReference Include="ExcelDna.Interop" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GanttCreator.Core\GanttCreator.Core.csproj" />
    <ProjectReference Include="..\GanttCreator.Office\GanttCreator.Office.csproj" />
    <ProjectReference Include="..\GanttCreator.Raster\GanttCreator.Raster.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      RibbonResources.resx carries the RibbonX document as a ResXFileRef to
      RibbonResources\Ribbon.xml. The strongly-typed accessor
      RibbonResources.Designer.cs is committed (generated by
      StronglyTypedResourceBuilder), matching the Excel-DNA CSfull template
      pattern, so RibbonX XML never appears as a C# string literal and no
      formatter disagreement is possible.
    -->
    <EmbeddedResource Update="RibbonResources.resx">
      <Generator>PublicResxFileCodeGenerator</Generator>
      <LastGenOutput>RibbonResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="RibbonResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>RibbonResources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
